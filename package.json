{
  "name": "bilimusic-ios",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "BiliMusic iPhone sideload edition, based on HanversionOvO/BiliMusic v1.0.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:ipa": "bash scripts/build-unsigned-ipa.sh",
    "verify:project": "node scripts/verify-project.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "framer-motion": "12.40.0",
    "lucide-react": "0.511.0",
    "qrcode": "1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.6.0"
  },
  "overrides": {
    "motion-dom": "12.40.0",
    "motion-utils": "12.39.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/vite": "4.1.0",
    "@types/node": "22.15.30",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@vitejs/plugin-react": "4.5.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
